{
  "name": "streamhub",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "start": "bun packages/host/src/main.ts",
    "editor": "bun scripts/editor.ts",
    "simulator:check": "bun scripts/simulator-check.ts",
    "source:register": "bun scripts/register-command-source.ts",
