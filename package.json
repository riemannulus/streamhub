    "streamdeck:register": "bun scripts/register-streamdeck.ts",
    "demo": "bun scripts/demo.ts",
    "check": "bun run typecheck && bun test",
    "client": "bun scripts/client.ts",
    "hid:check": "bun scripts/hid-check.ts",
    "hid:restore": "bun scripts/hid-restore.ts",
    "hid:lifecycle-check": "bun scripts/hid-lifecycle-check.ts",
    "hid:pages-check": "bun scripts/hid-pages-check.ts",
