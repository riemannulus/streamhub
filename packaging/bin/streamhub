#!/bin/sh
set -eu

invocation_dir=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd)
STREAMHUB_COMMAND_PATH=$invocation_dir/$(basename -- "$0")
export STREAMHUB_COMMAND_PATH
launcher=$0
while [ -L "$launcher" ]; do
  launcher_dir=$(CDPATH= cd -P -- "$(dirname -- "$launcher")" && pwd)
  link=$(readlink "$launcher")
  case "$link" in /*) launcher=$link ;; *) launcher=$launcher_dir/$link ;; esac
done
package_root=$(CDPATH= cd -P -- "$(dirname -- "$launcher")/.." && pwd)
export STREAMHUB_PACKAGE_ROOT=$package_root
if [ -z "${STREAMHUB_CONFIG:-}" ]; then
  STREAMHUB_CONFIG=$HOME/Library/Application\ Support/Streamhub/data/config.json
  export STREAMHUB_CONFIG
fi
exec bun "$package_root/app/cli.js" "$@"
